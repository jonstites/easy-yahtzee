# -*- mode: gitignore; -*-
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Org-mode
.org-id-locations
*_archive

# flymake-mode
*_flymake.*

# eshell files
/eshell/history
/eshell/lastdir

# elpa packages
/elpa/

# reftex files
*.rel

# AUCTeX auto folder
/auto/

# cask packages
.cask/
dist/

# Flycheck
flycheck_*.el

# server auth directory
/server/

# projectiles files
.projectile

# directory configuration
.dir-locals.el

# network security
/network-security.data

# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# Generated wasm-pack output
crates/wasm/pkg/

# Solver cache. `scores.bin.br` is the canonical artifact and IS tracked — it's
# the embed source for the CLI binary and what the web dev server streams. The
# intermediate uncompressed `scores.bin` and the human-readable `MANIFEST` are
# regenerable and not tracked. Regenerate with:
#   cargo run -p yahtzee-cli --release -- build --output crates/cli/data/scores.bin --brotli
crates/cli/data/scores.bin
crates/cli/data/MANIFEST

# Node / pnpm
node_modules/
**/node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite / build output
web/dist/
**/dist/
web/.vite/
**/.vite/
*.tsbuildinfo

# Playwright artefacts
web/test-results/
web/playwright-report/
web/blob-report/
web/.playwright/

# Env files (never commit secrets)
.env
.env.local
.env.*.local

# Editor / IDE scratch
.vscode/
.idea/
*.swp
*.swo

# OS cruft
.DS_Store
Thumbs.db
